// app.ts — generated by the JS-Delphi BuildService (project file, Delphi .dpr equivalent). Do not edit.
import { Application, DataService } from './vcl';
import type { TFormClass } from './vcl';
{% for f in forms %}
import { {{ f.name | ident }} } from './{{ f.name | ident }}';
{% endfor %}

DataService.RegisterConnections({{ connections | to_ts_literal }});
Application.Title = {{ project.title | to_ts_literal }};
Application.Initialize();

const requested: string = document.body.dataset.mainForm || {{ project.main_form | to_ts_literal }};
const MainForm: TFormClass = Application.FindFormClass(requested) ?? {{ main_form | ident }};
Application.CreateForm(MainForm);
{% for name in auto_create %}
if (MainForm !== {{ name | ident }}) Application.CreateForm({{ name | ident }});
{% endfor %}
Application.Run();
