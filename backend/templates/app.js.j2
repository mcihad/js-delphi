// app.js — generated by the JS-Delphi BuildService (project file, Delphi .dpr equivalent). Do not edit.
import { Application, DataService } from './vcl.js';
{% for f in forms %}
import { {{ f.name | ident }} } from './{{ f.name | ident }}.js';
{% endfor %}

// ConnectionDefName → backend connection id (no secrets: credentials stay on the server)
DataService.RegisterConnections({{ connections | to_ts_literal }});
Application.Title = {{ project.title | to_ts_literal }};
Application.Initialize();

const requested = document.body.dataset.mainForm || {{ project.main_form | to_ts_literal }};
const MainForm = Application.FindFormClass(requested) ?? {{ main_form | ident }};
Application.CreateForm(MainForm);
{% for name in auto_create %}
if (MainForm !== {{ name | ident }}) Application.CreateForm({{ name | ident }});
{% endfor %}
Application.Run();
